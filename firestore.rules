rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    
    // Appointment Validation
    function isValidAppointment(data) {
      return data.keys().hasAll(['petName', 'ownerName', 'date', 'status', 'createdAt'])
        && data.keys().size() >= 5 && data.keys().size() <= 12
        && data.petName is string && data.petName.size() >= 1 && data.petName.size() <= 100
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 100
        && data.date is string && data.date.size() <= 20
        && data.status == 'pending'
        && data.createdAt == request.time
        && (!('time' in data) || (data.time is string && data.time.size() <= 20))
        && (!('email' in data) || data.email == "" || (data.email is string && data.email.size() <= 100 && data.email.matches('^[^@]+@[^@]+\\.[^@]+$')))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('catAge' in data) || (data.catAge is string || data.catAge is int || data.catAge is float))
        && (!('ageUnit' in data) || (data.ageUnit in ['Years', 'Months']))
        && (!('gender' in data) || (data.gender in ['Male', 'Female']))
        && (!('serviceType' in data) || (data.serviceType is string && data.serviceType.size() <= 100));
    }

    match /appointments/{appointmentId} {
      // Public can book an appointment
      allow create: if isValidId(appointmentId) && isValidAppointment(incoming());
      
      // Reading restricted for PII safety. Admin check could be added if needed.
      allow read: if false;
    }

    match /test/connection {
      allow read: if true;
    }
  }
}

{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "Details for a veterinary appointment booking",
      "type": "object",
      "properties": {
        "petName": { "type": "string", "description": "The name of the cat" },
        "ownerName": { "type": "string", "description": "The name of the owner" },
        "catAge": { "type": "string", "description": "Age of the cat" },
        "ageUnit": { "type": "string", "enum": ["Years", "Months"] },
        "gender": { "type": "string", "enum": ["Male", "Female"] },
        "email": { "type": "string", "format": "email", "description": "Owner email address" },
        "serviceType": { "type": "string", "description": "The requested service" },
        "date": { "type": "string", "description": "Preferred date" },
        "time": { "type": "string", "description": "Preferred time slot" },
        "notes": { "type": "string", "description": "Additional notes" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["petName", "ownerName", "date", "status", "createdAt"]
    }
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Collection for appointment requests"
    }
  }
}
